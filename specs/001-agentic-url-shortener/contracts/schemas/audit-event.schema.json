{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-url-shortener.local/schemas/audit-event.schema.json",
  "title": "AuditEvent",
  "type": "object",
  "required": ["event_id", "run_id", "actor_type", "action", "occurred_at", "result"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "run_id": { "type": "string", "format": "uuid" },
    "actor_type": { "type": "string", "enum": ["human", "system", "agent"] },
    "action": { "type": "string", "minLength": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "affected_artifact": { "type": ["string", "null"] },
    "result": { "type": "string", "enum": ["success", "failure", "pending"] },
    "reason": { "type": ["string", "null"] }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "result": { "const": "failure" } } },
      "then": {
        "required": ["reason"],
        "properties": { "reason": { "type": "string", "minLength": 1 } }
      }
    }
  ]
}
