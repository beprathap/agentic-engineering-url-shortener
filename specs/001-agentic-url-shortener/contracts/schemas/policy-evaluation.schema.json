{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-url-shortener.local/schemas/policy-evaluation.schema.json",
  "title": "PolicyCheckResult",
  "type": "object",
  "required": ["result_id", "run_id", "policy_id", "policy_version", "outcome", "evaluated_at"],
  "properties": {
    "result_id": { "type": "string", "format": "uuid" },
    "run_id": { "type": "string", "format": "uuid" },
    "policy_id": { "type": "string", "minLength": 1 },
    "policy_version": { "type": "string", "minLength": 1 },
    "outcome": {
      "type": "string",
      "enum": ["PASS", "FAIL", "EXCEPTION_REQUESTED", "NOT_APPLICABLE"]
    },
    "evaluated_at": { "type": "string", "format": "date-time" },
    "exception_id": { "type": ["string", "null"], "format": "uuid" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "EXCEPTION_REQUESTED" } } },
      "then": { "required": ["exception_id"] }
    }
  ],
  "$defs": {
    "PolicyException": {
      "type": "object",
      "required": [
        "exception_id",
        "applicable_policy",
        "reason",
        "scope",
        "approving_authority",
        "compensating_control",
        "approved_at",
        "expires_at"
      ],
      "properties": {
        "exception_id": { "type": "string", "format": "uuid" },
        "applicable_policy": { "type": "string" },
        "reason": { "type": "string" },
        "scope": { "type": "string" },
        "approving_authority": { "type": "string" },
        "compensating_control": { "type": "string" },
        "approved_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  }
}
